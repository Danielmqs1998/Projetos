# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no git.

MONGO_URI=mongodb://localhost:27017
MONGO_DB=wproject
APP_PORT=3000
APP_USER=usuario_app
APP_PASS=senha_segura

# Chave HMAC-SHA256 para assinar tokens JWT.
# Gere com: openssl rand -hex 32
JWT_SECRET=substitua_por_uma_chave_de_pelo_menos_32_caracteres

# Tempo de expiracao do token em milissegundos (padrao: 1 hora)
JWT_EXPIRATION_MS=3600000

# Origens permitidas para CORS (separadas por virgula)
CORS_ORIGINS=http://localhost:8080
